# Service Nest — local development environment variables
# Copy to .env and adjust values. Never commit .env.

# HTTP port for cmd/local (default 8080)
PORT=8080

# Runtime mode: local | prod (prod inferred automatically on Lambda)
APP_ENV=local

# AWS region for SDK clients
AWS_REGION=us-east-1

# DynamoDB (use DynamoDB Local for local dev)
DYNAMODB_TABLE=servicenest
DYNAMODB_ENDPOINT=http://localhost:8001

# S3 bucket for category images (real AWS in prod; optional endpoint for MinIO later)
S3_BUCKET=service-nest-category1
# S3_ENDPOINT=http://localhost:9000

# SNS error notifications (leave empty locally to disable)
# SNS_TOPIC_ARN=

# JWT signing secret (required). Legacy name SECRET also supported in prod.
JWT_SECRET=change-me-local-dev-secret

# Gmail SMTP for OTP in prod (optional locally until BACKEND-008 console logging)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=your-email@gmail.com
SMTP_APP_PASSWORD=
# Legacy prod name: APP_PASSWORD

# --- Prod deploy (scripts/deploy.ps1) ---
# Set AWS_PROFILE before deploy. Secrets are passed as SAM parameters (not stored in template).
# AWS_PROFILE=your-prod-profile
# CONFIRM_CHANGESET=false   # optional: skip interactive changeset prompt
